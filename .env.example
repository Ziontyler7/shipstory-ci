# ShipStory CI — GitLab Transcend Hackathon Configuration (Port 5182)
# Works 100% out-of-the-box in 0ms deterministic_local mode with zero API keys required.

VITE_HOST=127.0.0.1
VITE_PORT=5182
VITE_STRICT_PORT=true
VITE_DEFAULT_MODE=deterministic_local

# Optional GitLab Duo Agent Platform / BYOK Endpoint (4,500ms circuit breaker fallback)
VITE_GITLAB_DUO_ENDPOINT=
VITE_GITLAB_TOKEN=
